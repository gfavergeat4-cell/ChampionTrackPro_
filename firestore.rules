rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return signedIn() && userExists() && me().data != null && me().data.role != null
        ? me().data.role
        : null;
    }

    function isAdmin() {
      return signedIn() && userExists() && myRole() == "admin";
    }

    function isCoach() {
      return signedIn() && userExists() && myRole() == "coach";
    }

    // Membre via subcollection members/{uid}
    function isTeamMember(teamId) {
      return signedIn() &&
             exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function myTeamId() {
      return signedIn() && userExists() && me().data != null && me().data.teamId != null
        ? me().data.teamId
        : null;
    }

    // Coach membre d'une équipe spécifique
    function isCoachOfTeam(teamId) {
      return isCoach() && isTeamMember(teamId);
    }

    function canReadTrainings(teamId) {
      return isAdmin() ||
             isCoachOfTeam(teamId) ||
             (signedIn() && (
               (userExists() && myTeamId() == teamId) ||
               exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
             ));
    }

    // ─────────────────────────────────────────────────────────
    // users/{uid}
    // ─────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn() && (
        uid == request.auth.uid ||
        isAdmin() ||
        (isCoach() && resource.data != null && resource.data.teamId != null && isTeamMember(resource.data.teamId))
      );

      allow create: if signedIn() && request.auth.uid == uid;

      // FIX VULN-03: block self-update of role and teamId fields
      allow update: if signedIn() && (
        isAdmin() ||
        (uid == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'teamId']))
      );

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    // collectionGroup: responses
    // FIX VULN-02: scope to coach's own team via teamId field in response doc
    // ─────────────────────────────────────────────────────────
    match /{path=**}/responses/{responseId} {
      allow read: if isAdmin() ||
                  (isCoach() &&
                   resource.data.teamId != null &&
                   exists(/databases/$(database)/documents/teams/$(resource.data.teamId)/members/$(request.auth.uid)));
    }

    // ─────────────────────────────────────────────────────────
    // teams/{teamId}
    // FIX VULN-01: removed unauthenticated read (request.auth == null)
    // Authenticated users can read to look up team codes during join flow
    // ─────────────────────────────────────────────────────────
    match /teams/{teamId} {
      allow read: if signedIn();

      allow create, delete: if isAdmin();

      allow update: if isAdmin() ||
                       (signedIn() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
                        request.resource.data.members == resource.data.members + 1);

      match /members/{uid} {
        allow read: if isAdmin() || isCoachOfTeam(teamId) || isTeamMember(teamId);
        allow create: if signedIn() && (request.auth.uid == uid || isCoach() || isAdmin());
        allow update: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow delete: if isAdmin();
      }

      match /trainings/{trainingId} {
        allow read: if canReadTrainings(teamId);
        allow create: if isAdmin() || (
          signedIn() &&
          isTeamMember(teamId) &&
          request.resource.data.isTestSession == true &&
          request.resource.data.createdBy == request.auth.uid
        );
        allow update, delete: if isAdmin();

        match /responses/{responseId} {
          function trainingExists() {
            return exists(/databases/$(database)/documents/teams/$(teamId)/trainings/$(trainingId));
          }

          function isQuestionnaireWindowOpen() {
            let training = get(/databases/$(database)/documents/teams/$(teamId)/trainings/$(trainingId));
            let endUtc = training.data.endUtc;
            let isTest = training.data.isTestSession == true;
            return isTest || (
              endUtc == null || (
                request.time >= endUtc &&
                request.time <= endUtc + duration.value(5, 'h')
              )
            );
          }

          allow get: if signedIn()
                     && trainingExists()
                     && (
                       isAdmin()
                       || (responseId == request.auth.uid && (
                         isTeamMember(teamId) ||
                         (userExists() && myTeamId() == teamId)
                       ))
                       || isCoachOfTeam(teamId)
                     );

          allow list: if isAdmin() || isCoachOfTeam(teamId);

          allow create: if signedIn()
                        && trainingExists()
                        && responseId == request.auth.uid
                        && (
                          isAdmin() ||
                          (
                            (isTeamMember(teamId) || (userExists() && myTeamId() == teamId)) &&
                            isQuestionnaireWindowOpen()
                          )
                        );

          allow update: if signedIn()
                        && responseId == request.auth.uid
                        && trainingExists()
                        && (
                          isAdmin() ||
                          (
                            (isTeamMember(teamId) || (userExists() && myTeamId() == teamId)) &&
                            isQuestionnaireWindowOpen()
                          )
                        );

          allow delete: if isAdmin();
        }
      }
    }

    // ─────────────────────────────────────────────────────────
    // pendingQuestionnaireReminders — internal collection, Cloud Functions only
    // ─────────────────────────────────────────────────────────
    match /pendingQuestionnaireReminders/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Written by Cloud Functions (Admin SDK) only
    }

    // ─────────────────────────────────────────────────────────
    // ai_training_dataset — Phase 5, Cloud Functions only
    // ─────────────────────────────────────────────────────────
    match /ai_training_dataset/{doc} {
      allow read, write: if false;
    }
  }
}
